[Unit]
Description=Collect public NEBUVERSE storage measurements

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/collect-nebuverse-storage.py --config /etc/nebuverse-storage.json
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/www/dennishilk.github.io/data/nebuverse
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
