[Unit]
Description=WOPR security analyzer
Documentation=file:/srv/www/dennishilk.github.io/server/wopr-auth/README.md
After=local-fs.target

[Service]
Type=oneshot
User=wopr-security
Group=wopr-auth
SupplementaryGroups=adm
WorkingDirectory=/srv/www/dennishilk.github.io
ExecStart=/usr/bin/node /srv/www/dennishilk.github.io/scripts/wopr-security-analyzer.mjs /var/log/nginx/access.log
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log/nginx
ReadWritePaths=/var/lib/wopr/security
RestrictSUIDSGID=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
SystemCallArchitectures=native
