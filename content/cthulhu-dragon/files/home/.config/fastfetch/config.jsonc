{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": "~/.config/fastfetch/1.png",
  "logoType": "kitty-icat",
  "logoWidth": 30,
  "logoHeight": 15,
  "logoPadding": {
    "top": 1,
    "left": 2,
    "right": 4
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom"
    },
    {
      "key": "│  user    │",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "│ 󰇅 hname   │",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "│ 󰅐 uptime  │",
      "type": "uptime"
    },
    {
      "key": "│  distro  │",
      "type": "os",
      "format": "I use NixOS btw"
    },
    {
      "key": "│  kernel  │",
      "type": "kernel"
    },
    {
      "key": "│  wm      │",
      "type": "wm"
    },
    {
      "key": "│  term    │",
      "type": "terminal"
    },
    {
      "key": "│  shell   │",
      "type": "shell"
    },
    {
      "key": "│ 󰍛 cpu     │",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ 󰉉 root    │",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "│  memory  │",
      "type": "memory"
    },
    {
      "key": "│ 󰓡 swap    │",
      "type": "swap"
    },
    {
      "key": "├───────────┤",
      "type": "custom"
    },
    {
      "key": "│ PC        │",
      "type": "host",
      "format": "{5} {1} ({2})"
    },
    {
      "key": "│ ├ 󰢮 gpu   │",
      "type": "gpu",
      "format": "{1} {2} @ {12}"
    },
    {
      "key": "│ ├  disp  │",
      "type": "display",
      "order": "desc",
      "format": "{1}x{2} @ {3} Hz"
    },
    {
      "key": "│ └  age   │",
      "type": "command",
      "text": "marker=\"$HOME/.config/fastfetch/cthulhu-born\"; if [ -f \"$marker\" ]; then birth_install=$(stat -c %Y \"$marker\"); current=$(date +%s); echo $(((current - birth_install) / 86400)) days; else printf \"marker missing\\n\"; fi"
    },
    {
      "key": "│  colors  │",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "╰───────────╯",
      "type": "custom"
    }
  ]
}
